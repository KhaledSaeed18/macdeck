# MacDeck OS — init.rc for Samsung's stock Android 4.4 init (SM-T210).
# No Android framework: only ueventd (device nodes), adbd (dev access) and our deck.
#
# Notes learned on this device:
#  - Stock init REBOOTS INTO RECOVERY if /sepolicy fails to load, and if a "critical"
#    service keeps crashing. MacDeck OS lives in RECOVERY, so either would be a boot loop:
#    the stock policy files stay in the ramdisk and nothing here is marked critical.
#  - The bootloader ignores the image's own cmdline (androidboot.selinux=permissive has no
#    effect), so SELinux is switched to permissive here with `setenforce 0`.
#  - Samsung's adbd always runs as uid shell. Dev controls are therefore exposed through
#    debug.* properties, which the shell user may set:
#      adb shell setprop debug.macdeck.deck stop|start   stop/start the built-in deck
#      adb shell setprop debug.macdeck.reboot download   reboot into download mode
#      adb shell setprop debug.macdeck.reboot recovery   reboot into RECOVERY (TWRP)
#      adb shell setprop debug.macdeck.reboot normal     plain reboot (MacDeck OS)
#      adb shell setprop debug.macdeck.reboot off        power off
#    and /data/local/tmp is writable by shell for test binaries.
#  - Lives in KERNEL (main boot) since v1.3; TWRP stays in RECOVERY as the rescue tool.
#  - /system is mounted read-only only so adbd's shell (/system/bin/sh) and toolbox work.
#    Nothing from /system is started.

on early-init
    write /proc/1/oom_adj -16
    setcon u:r:init:s0
    setenforce 0
    start ueventd

on init
    export PATH /sbin:/system/bin:/system/xbin
    export LD_LIBRARY_PATH /system/lib
    export ANDROID_ROOT /system
    mkdir /tmp 0775 root root
    mount tmpfs tmpfs /tmp mode=0775
    mkdir /data 0771 root root
    mount tmpfs tmpfs /data mode=0771
    mkdir /data/local 0771 shell shell
    mkdir /data/local/tmp 0771 shell shell

# Charger boot (powered off + cable plugged in): the bootloader sets
# androidboot.mode=charger and init runs only "on charger". Samsung's kernel does not
# register the touchscreen in that low-power mode, so reboot straight into a normal boot
# (verified: a reboot from charger mode comes back as a normal boot). The net effect:
# plugging in a powered-off tablet turns the deck on.
on boot
    setprop macdeck.start 1

on charger
    powerctl reboot

on property:macdeck.start=1
    mount ext4 /dev/block/platform/sdhci-pxav3.2/by-name/SYSTEM /system ro wait
    # loopback is DOWN until someone brings it up; the deck's TCP listener needs it
    ifup lo
    hostname macdeck
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 04e8
    write /sys/class/android_usb/android0/idProduct 6860
    write /sys/class/android_usb/android0/iSerial $ro.serialno
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    # let the shell user (dev runs of the deck from /data/local/tmp) use the screen,
    # touch and backlight. Samsung's ueventd makes fb0 system:media 0660 otherwise.
    chown root graphics /dev/graphics/fb0
    chmod 0660 /dev/graphics/fb0
    chown shell graphics /sys/class/backlight/panel/brightness
    chmod 0664 /sys/class/backlight/panel/brightness
    start adbd
    start deck

on property:debug.macdeck.deck=stop
    stop deck

on property:debug.macdeck.deck=start
    start deck

on property:debug.macdeck.reboot=download
    powerctl reboot,download

on property:debug.macdeck.reboot=recovery
    powerctl reboot,recovery

on property:debug.macdeck.reboot=normal
    powerctl reboot

on property:debug.macdeck.reboot=off
    powerctl shutdown

service ueventd /sbin/ueventd
    seclabel u:r:ueventd:s0

service adbd /sbin/adbd
    socket adbd stream 660 system system
    disabled
    seclabel u:r:adbd:s0

service deck /sbin/deck
    disabled
    seclabel u:r:init_shell:s0
